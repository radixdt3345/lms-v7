# Database
DATABASE_URL=Host=localhost;Port=5432;Database=lms_dev;Username=postgres;Password=yourpassword

# JWT
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ISSUER=https://lms.example.com
JWT_AUDIENCE=lms-api

# Azure AD
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxx
SENDGRID_FROM_EMAIL=noreply@lms.example.com

# Hangfire
HANGFIRE_DB_URL=Host=localhost;Port=5432;Database=lms_hangfire;Username=postgres;Password=yourpassword

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_AZURE_AD_TENANT_ID=your-tenant-id
VITE_AZURE_AD_CLIENT_ID=your-client-id
